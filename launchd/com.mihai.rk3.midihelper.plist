<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mihai.rk3.midihelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/rk3midihelper</string>
	</array>
	<!-- Owns the "RigKontrol 3" CoreMIDI source for the whole login session and
	     relays foot-control reports from the audio engine (loopback UDP). -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/rk3midihelper.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/rk3midihelper.log</string>
</dict>
</plist>
